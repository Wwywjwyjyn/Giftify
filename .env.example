# ============ Giftify — تنظیمات محیطی ============
# این فایل را به .env کپی کنید:  cp .env.example .env

# دیتابیس SQLite (فایل داخل پوشه prisma ساخته می‌شود؛ روی هاست همان پوشه باید قابل نوشتن باشد)
DATABASE_URL="file:./dev.db"

# کلید امضای نشست‌ها — یک رشته تصادفی ۶۴ کاراکتری بگذارید (اجباری)
# برای ساخت:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# توکن API مارکت‌اپ — فقط سمت سرور استفاده می‌شود، هرگز به کلاینت فرستاده نمی‌شود
# دریافت توکن: وارد marketapp.org شوید → از منو «API token» → توکن رایگان بگیرید
# (اگر فید فروش و خرید NFT را می‌خواهید، همان صفحه پلن API را فعال کنید — بدون تغییر کد فعال می‌شود)
MARKETAPP_API_TOKEN=""

# ربات تلگرام (اختیاری — برای ورود خودکار داخل Mini App)
# با BotFather ربات بسازید، توکن را اینجا بگذارید و یوزرنیم ربات را در خط بعدی بنویسید
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# نام نمایشی سایت
NEXT_PUBLIC_SITE_NAME="Giftify"

# آدرس عمومی سایت (برای مانیفست TON Connect) — خالی بگذارید تا خودکار از دامنه ساخته شود
NEXT_PUBLIC_BASE_URL=""

# پورت (سی‌پنل خودش ست می‌کند؛ دیپلکسو هم PORT می‌دهد)
PORT=3000
