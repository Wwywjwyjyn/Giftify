generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  role       String   @default("USER") // ADMIN | USER — اولین کاربرِ تأییدشده = ADMIN
  wallet     String?  @unique // آدرس TON (verified با ton_proof)
  telegramId String?  @unique
  name       String?
  photo      String?
  verified   Boolean  @default(true)
  createdAt  DateTime @default(now())
  lastSeen   DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Order {
  id        String    @id @default(cuid())
  userId    Int? // خریدار / اجاره‌گیرنده
  kind      String // stars | premium | ads | telegram_topup | nft | rent | local_buy | local_rent
  title     String
  amountTon Float // مبلغ اصلی (TON)
  feeTon    Float     @default(0) // کارمزد سایت (شفاف ثبت می‌شود)
  currency  String    @default("TON")
  status    String    @default("PENDING_TX") // PENDING_TX | TX_SENT | AWAITING_DELIVERY | DELIVERED | DONE | FAILED | CANCELLED | RENT_ACTIVE | RENT_OVERDUE
  meta      String    @default("{}")
  txHash    String?
  payMethod String? // wallet | ton
  nftAddress String? // برای تحویل/بازگشت واقعی NFT
  sellerWallet String? // فروشندهٔ لیستینگ محلی
  endAt     DateTime? // پایان دورهٔ اجاره
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FeeRecord {
  id        String   @id @default(cuid())
  orderId   String?
  section   String // usernames | numbers | gifts | rent | stars | premium | giveaway | ads | deposit
  amountTon Float
  wallet    String // کیف پول کارمزد (ادمین)
  status    String   @default("PENDING") // PENDING | PAID
  txHash    String?
  createdAt DateTime @default(now())
}

model KV {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ImageCache {
  address   String   @id
  url       String
  updatedAt DateTime @updatedAt
}

model LocalListing {
  id             String   @id @default(cuid())
  ownerWallet    String
  kind           String // username | number | gift
  name           String
  collectionSlug String?
  itemNum        Int?
  nftAddress     String? // اگر آیتم واقعاً روی زنجیره است — برای تحویل/بازگشت با تراکنش واقعی
  priceTon       Float?
  rentPerDayTon  Float?
  rentMinDays    Int?
  rentMaxDays    Int?
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt      DateTime @default(now())
}

/**
 * کش آیتم‌های اجاره — چون endpoint جزئیات NFT مارکت‌اپ «پولی» است،
 * اطلاعات اجاره هر آیتم از فیدِ رایگان اجاره اینجا ذخیره می‌شود تا
 * صفحه آیتم و دکمه «اجاره کردن» بدون پلن پولی هم کار کنند.
 */
model RentCache {
  nftAddress     String   @id
  kind           String // gifts | usernames | numbers
  name           String
  pricePerDay    Float // TON در روز
  minDurationSec Int
  maxDurationSec Int
  owner          String?
  attrs          String   @default("[]")
  listedAt       Int?
  updatedAt      DateTime @updatedAt
}

/**
 * کیف پول داخلی سایت — موجودی گرام (TON) هر کاربر.
 * واریز: کاربر TON به کیف واریز ادمین (deposit_wallet) با کد یادمان می‌فرستد.
 * هزینه‌کرد: خرید/اجاره/استارز/پرمیوم از همین موجودی.
 */
model WalletAccount {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  memoCode   String   @unique // کد یادمان واریز — مثل GFT-4X7K9
  balanceTon Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/** دفتر تراکنش‌های کیف پول داخلی — هر تغییر موجودی یک ردیف */
model WalletTx {
  id           String   @id @default(cuid())
  userId       Int
  type         String // DEPOSIT | SPEND | CREDIT | FEE | REFUND | HOLD | RELEASE
  amountTon    Float // همیشه مثبت — جهت با type مشخص می‌شود
  balanceAfter Float
  orderId      String?
  note         String   @default("")
  txHash       String? @unique // هش تراکنش واریز (ضد دوبار شمارش)
  meta         String   @default("{}")
  createdAt    DateTime @default(now())
}

/**
 * مرکز بروزرسانی — هر فایل به‌روزرسانی که ادمین در پنل بارگذاری می‌کند
 * یک ردیف اینجا ثبت می‌شود: نسخه، عنوان، لیست تغییرات (fix/feature/…)، زمان اعمال.
 * اگر فایل شامل تنظیمات (کارمزد/قیمت/اعلان) باشد همان لحظه اعمال می‌شود.
 */
model SiteUpdate {
  id        String   @id @default(cuid())
  version   String   @unique // semver مثل 3.1.0
  title     String
  changes   String   @default("[]") // JSON: [{type: fix|feature|improvement|security, text}]
  fileName  String?
  appliedSettings Boolean @default(false)
  appliedAt DateTime @default(now())
}
